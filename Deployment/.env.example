# Copy to .env next to docker-compose.yml and fill in, then run .\update.ps1.
# Only the app host's own settings belong here. Each application keeps its settings in its own folder.

# ── Required ──────────────────────────────────────────────────────────────────────────────────────
# The folder holding every application folder: C:/Docker on the server, with C:/Docker/MyApp
# inside it (sync-apps.ps1 points it at the repository's build folder instead). The app host mounts it
# read-only and reads only the folders apps.json registers. On Docker Desktop for Windows use a
# forward-slash Windows path.
APPHOST_APPS_ROOT=C:/Docker

# ── Optional ──────────────────────────────────────────────────────────────────────────────────────
# Host name or address browsers reach this server by, e.g. its LAN IP. The dashboard's links to each
# application use it. Left unset they say localhost, which works from this server only.
#APPHOST_PUBLIC_HOST=localhost

# Address the applications' ports are published on. 127.0.0.1 makes them reachable from this server only.
#APPHOST_BIND_ADDRESS=0.0.0.0

# Dashboard authentication. Left unset, the dashboard asks for a login token, printed in the app host's log:
#   docker logs app-host
# true removes that check and exposes every log line, trace and environment variable in the dashboard to
# anyone who can reach port 15100. Only for a trusted network.
#APPHOST_DASHBOARD_ANONYMOUS=false

# The app host's own image.
#APPHOST_REGISTRY=ghcr.io/hwndmaster
#APPHOST_IMAGE_TAG=latest

# Registry for applications whose app.json names none.
#APPHOST_APPS_REGISTRY=ghcr.io/hwndmaster

# Memory limit of the app host container, in docker's notation.
#APPHOST_MEMORY_LIMIT=768m
