<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only. Nothing here comes from GitHub Packages, so the image builds without a token, and
       central package management needs a single source (NU1507) unless sources are mapped. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
